# Server Port
PORT=5000

# JSON Web Token Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# College Identity
COLLEGE_NAME=Government Arts and Science College, Idappadi

# Initial Admin Credentials (Sports Incharge)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# ==========================================
# SUPABASE DATABASE CONFIGURATION
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==========================================
# EMAIL (SMTP) OTP NOTIFICATION CONFIG
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=sportsgascidappadi@gmail.com
EMAIL_PASS=rbleakzbcyzsktsr
EMAIL_FROM="GASC Idappadi Sports Dept" <sportsgascidappadi@gmail.com>

# ==========================================
# SECURE PAYMENT GATEWAY (RAZORPAY) CONFIG
# ==========================================
# 1. Start in TEST MODE (rzp_test_...) before completing merchant onboarding.
# 2. Never commit secrets to public repositories or bundle them in the client EXE.
# 3. Bank settlement destination is configured exclusively via Razorpay Merchant Dashboard KYC.
PAYMENT_PROVIDER=RAZORPAY
PAYMENT_MODE=TEST
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

