{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|woff2|woff|ttf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/competitions.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=60, stale-while-revalidate=300" }
      ]
    },
    {
      "source": "/roster.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=60, stale-while-revalidate=300" }
      ]
    },
    {
      "source": "/api/competitions",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=20, stale-while-revalidate=60" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/payments/(.*)", "destination": "/api/open-registration" },
    { "source": "/api/payments", "destination": "/api/open-registration" },
    { "source": "/api/open-registration/(.*)", "destination": "/api/open-registration" },
    { "source": "/api/open-registration", "destination": "/api/open-registration" },
    { "source": "/api/inter-college/(.*)", "destination": "/api/open-registration" },
    { "source": "/api/inter-college", "destination": "/api/open-registration" },
    { "source": "/api/competitions/(.*)", "destination": "/api/competitions" },
    { "source": "/api/competitions", "destination": "/api/competitions" },
    { "source": "/api/cm-trophy/(.*)", "destination": "/api/open-registration" },
    { "source": "/api/cm-trophy", "destination": "/api/open-registration" },
    { "source": "/open-registration/(.*)", "destination": "/index.html" },
    { "source": "/open-registration", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin-dashboard.html" },
    { "source": "/admin/", "destination": "/admin-dashboard.html" },
    { "source": "/admin/dashboard", "destination": "/admin-dashboard.html" },
    { "source": "/admin/login", "destination": "/admin-login.html" },
    { "source": "/student/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
