{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/open-registration/(.*)", "destination": "/api/open-registration" },
    { "source": "/api/open-registration", "destination": "/api/open-registration" },
    { "source": "/api/inter-college/(.*)", "destination": "/api/open-registration" },
    { "source": "/api/inter-college", "destination": "/api/open-registration" },
    { "source": "/api/competitions/(.*)", "destination": "/api/open-registration" },
    { "source": "/api/competitions", "destination": "/api/open-registration" },
    { "source": "/open-registration/(.*)", "destination": "/index.html" },
    { "source": "/open-registration", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin-dashboard.html" },
    { "source": "/admin/", "destination": "/admin-dashboard.html" },
    { "source": "/admin/dashboard", "destination": "/admin-dashboard.html" },
    { "source": "/admin/login", "destination": "/admin-login.html" },
    { "source": "/student/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
