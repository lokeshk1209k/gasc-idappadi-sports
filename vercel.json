{
  "version": 2,
  "buildCommand": "cd student-client && npm install && npm run build",
  "outputDirectory": "student-client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/uploads/:path*", "destination": "/api" },
    { "source": "/((?!assets|images|favicon|_next).*)", "destination": "/index.html" }
  ]
}
