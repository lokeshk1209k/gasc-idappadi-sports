{
  "name": "gasc-idappadi-sports-management",
  "version": "1.2.0",
  "description": "Smart Sports Management System for Government Arts and Science College, Idappadi",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "build": "npm --prefix student-client run build && node scripts/prepare-dist.js",
    "seed": "node server/utils/seedSupabase.js",
    "desktop:admin": "electron electron/main.js",
    "build:admin-exe": "node electron/pack.js",
    "build:admin-builder": "electron-builder --win"
  },
  "keywords": [
    "sports",
    "college",
    "gasc-idappadi",
    "management",
    "glassmorphism",
    "express",
    "supabase",
    "postgresql",
    "electron",
    "windows-exe"
  ],
  "author": "GASC Idappadi Sports Department",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.0",
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.2",
    "uuid": "^14.0.2",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.gasc.idappadi.sports.admin",
    "productName": "GASC Sports Admin",
    "copyright": "Copyright © 2026 Government Arts and Science College, Idappadi",
    "directories": {
      "output": "dist/admin-installer",
      "buildResources": "build-resources"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "client/public/**/*",
      "server/**/*",
      "api/**/*",
      "dist/**/*",
      "!dist/admin-*/**",
      "!dist/admin-exe/**",
      "!dist/admin-installer/**",
      "package.json",
      ".env",
      "gasc_sports_local.db"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "gasc_sports_local.db",
        "to": "gasc_sports_local.db"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GASC Sports Admin",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "GASC-Sports-Admin-Setup-1.2.0.exe"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
